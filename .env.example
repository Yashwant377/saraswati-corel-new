# ----------------------------------------------------------------------------
# Initial Super Admin — used ONLY to seed the first account.
# The seeded admin is FORCED to change this password after first login.
# Never commit real credentials; copy this file to .env.local and edit.
# ----------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe@12345

# Secret used to sign admin session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ----------------------------------------------------------------------------
# DATABASE (required in production / on Vercel)
# ----------------------------------------------------------------------------
# Postgres connection string. On Vercel + Neon this is injected automatically
# when you connect the database via Vercel → Storage (or Neon → Integrations).
#
# Leave it EMPTY for local development: the app then stores everything in
# data/db.json exactly as before.
#
# Use the POOLED connection string (the host contains "-pooler") for serverless.
DATABASE_URL=postgresql://neondb_owner:npg_zESH10PeuOrL@ep-spring-mud-azjrc49q-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require


# ----------------------------------------------------------------------------
# LEAD ALERTS (recommended — optional)
# ----------------------------------------------------------------------------
# Any endpoint that accepts a JSON POST: Zapier, Make, n8n, Google Apps Script,
# WhatsApp Cloud API, Slack webhook… Every enquiry is pushed here the moment it
# is captured, and failures are reported too, so a lead can never be lost
# silently.
#
# Events sent: lead.created · lead.failed · visit.created · visit.failed
LEAD_WEBHOOK_URL=

# Shown in webhook payloads
PROJECT_NAME=Saraswati Coral

# ----------------------------------------------------------------------------
# FILE UPLOADS (MahaRERA QR code / certificate)
# ----------------------------------------------------------------------------
# Vercel's filesystem is read-only, so uploads need object storage.
# Configure either Vercel Blob or an S3-compatible bucket (Neon Object Storage).
BLOB_READ_WRITE_TOKEN=      # Vercel Blob (injected by Vercel → Storage → Blob)
S3_ENDPOINT=                # e.g. https://<bucket>.s3.<region>.amazonaws.com
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=ap-southeast-1
